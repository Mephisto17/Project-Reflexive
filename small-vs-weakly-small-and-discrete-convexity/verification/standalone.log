TalagrandIntegral.fractional_to_integral {X : Type} [Fintype X] [DecidableEq X] {r : ℝ} (hr : 0 ≤ r)
  {F : Finset (Finset X)} {g : Finset X → ℝ} (hg : TalagrandIntegral.FractionalCover r F g) :
  TalagrandIntegral.Small (r / TalagrandIntegral.comparisonConstant) F
TalagrandIntegral.comparison_theorem_1_1 {X : Type} [Fintype X] [DecidableEq X] {F : Finset (Finset X)} (hF : ∅ ∉ F) :
  TalagrandIntegral.fractionalThreshold F ≤ TalagrandIntegral.comparisonConstant * TalagrandIntegral.integralThreshold F
TalagrandIntegral.integral_two_unions {X : Type} [Fintype X] [DecidableEq X] {p : ℝ} (hp : 0 < p) (hp1 : p < 1)
  (A : Set (TalagrandConjectures.Cube X)) (hm : 1 / 2 ≤ TalagrandConjectures.measure p A) :
  TalagrandIntegral.IntegralSmall (p / (50 * 512 ^ 4)) (TalagrandConjectures.badTwo A)
TalagrandIntegral.discrete_convexity_theorem_1_1 {X : Type} [Fintype X] [DecidableEq X] {p : ℝ} (hp : 0 < p)
  (hp1 : p < 1) (D : Set (TalagrandConjectures.Cube X)) (hD : 1 - 1 / 2 ^ 75 ≤ TalagrandConjectures.measure p D) :
  TalagrandIntegral.IntegralSmall p (TalagrandConjectures.badUnions (2 ^ 75) D)
